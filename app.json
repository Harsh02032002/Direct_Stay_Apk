{
  "expo": {
    "name": "DirectStay Admin",
    "slug": "directstay-admin-mobile",
    "version": "1.3.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "directstayadmin",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#17120F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.directstay.admin",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "upi",
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "bhim",
          "tel",
          "mailto"
        ],
        "NSPhotoLibraryUsageDescription": "DirectStay Admin accesses your photo library to save and share guest tax invoices and GRC registration PDFs.",
        "NSPhotoLibraryAddUsageDescription": "DirectStay Admin saves generated GST invoices and GRC documents to your device.",
        "NSCameraUsageDescription": "DirectStay Admin uses the camera only when scanning or uploading hotel and guest verification documents."
      }
    },
    "android": {
      "package": "com.directstay.admin",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17120F"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "apiBaseUrl": "https://directstay.online"
    }
  }
}
